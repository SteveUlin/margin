# margin's feed supervisor for one project store, as a systemd user unit. Shipped, not installed.
#
# The instance name is the project slug (`margin ls` prints the store's project; for /home/me/project
# it's home-me-project). Install and start, from a checkout of margin (the flake package ships this
# file in share/margin/units/):
#   cp units/margin-daemon@.service ~/.config/systemd/user/
#   systemctl --user enable --now margin-daemon@home-me-project
#
# Why a unit at all: the CLI starts `margin daemon` on demand and the daemon exits when no feed is
# left, which is enough day to day. A unit adds restart-on-crash and start-at-login for feeds you
# want running before any CLI call. The daemon holds a flock per project, so a unit and an
# on-demand start never run two supervisors.
#
# Restart=always, not on-failure: with no feeds registered the daemon exits 0 by design, and the
# unit then waits RestartSec before checking again, which costs one process start per minute.
[Unit]
Description=margin feed supervisor (%i)
Documentation=https://github.com/SteveUlin/margin/blob/main/docs/design.md

[Service]
# `env` finds margin on the PATH below; replace it with an absolute path if yours lives elsewhere
# (a checkout's target/release/margin, say)
ExecStart=/usr/bin/env margin daemon --project %i
Restart=always
RestartSec=60
# feeds shell out to jj, jq, bash: give them the user's normal PATH (cargo, ~/.local, nix, then the system)
Environment=PATH=%h/.cargo/bin:%h/.local/bin:%h/.nix-profile/bin:/etc/profiles/per-user/%u/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
