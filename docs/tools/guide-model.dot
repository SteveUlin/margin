digraph M {
  bgcolor="#2d353b"; pad=0.2; nodesep=0.25; ranksep=0.38; fontname="DejaVu Sans";
  node [shape=box style="rounded,filled" fillcolor="#343f44" color="#7a8478" fontcolor="#d3c6aa" fontname="DejaVu Sans" fontsize=21 penwidth=1.6 margin="0.12,0.07"];
  edge [color="#859289" fontcolor="#9da9a0" fontname="DejaVu Sans" fontsize=18 arrowsize=0.9 penwidth=1.5];
  rankdir=TB;
  claude [label="Claude\nCLI ops" fillcolor="#3a515d" color="#7fbbb3"];
  feed   [label="feed\nstdout ops" fillcolor="#4d4c43" color="#dbbc7f"];
  doc    [label="doc.json\ncontent" shape=note fillcolor="#425047" color="#a7c080"];
  rend   [label="margin view\n(+ view.json)" fillcolor="#425047" color="#a7c080"];
  host   [label="pane\nZellij or plain"];
  you    [label="you\nkey · mg: token" fillcolor="#4c3f4c" color="#d699b6"];
  state  [label="state.json\ndecisions" shape=note fillcolor="#4c3f4c" color="#d699b6"];
  ev     [label="events\n.jsonl" shape=note fillcolor="#4c3f4c" color="#d699b6"];
  hook   [label="hooks" fillcolor="#3a515d" color="#7fbbb3"];
  { rank=same; claude; feed; }
  { rank=same; state; ev; }
  claude -> doc; feed -> doc;
  doc -> rend [label=" watches"];
  rend -> host [label=" draws"];
  host -> you;
  you -> state [color="#d699b6"]; you -> ev [color="#d699b6"];
  state -> rend [color="#d699b6" constraint=false style=dashed];
  ev -> hook [color="#7fbbb3"];
  hook -> claude [color="#7fbbb3" constraint=false label=" margin:\n lines" fontcolor="#7fbbb3"];
}
