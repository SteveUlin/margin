digraph A {
  bgcolor="#2d353b"; pad=0.3; nodesep=0.4; ranksep=0.55; fontname="DejaVu Sans"; fontcolor="#9da9a0"; fontsize=12;
  node [shape=box style="rounded,filled" fillcolor="#343f44" color="#7a8478" fontcolor="#d3c6aa" fontname="DejaVu Sans" fontsize=12.5 penwidth=1.2 margin="0.18,0.08"];
  edge [color="#859289" fontcolor="#9da9a0" fontname="DejaVu Sans" fontsize=10.5 arrowsize=0.7 penwidth=1.1];
  rankdir=LR; compound=true;
  subgraph cluster_ai { label="Claude Code session (pane in tab T)"; color="#475258"; style=rounded;
    cc [label="Claude Code"];
    hook [label="UserPromptSubmit hook\nmargin events --unread"];
  }
  subgraph cluster_margin { label="margin (one Rust binary)"; color="#a7c080"; style=rounded; fontcolor="#a7c080";
    cli [label="margin CLI\nput · patch · open · events" fillcolor="#425047" color="#a7c080"];
    mcp [label="MCP server\n(same ops, later)" style="rounded,dashed,filled"];
    view [label="margin view\nrenderer on vellum" fillcolor="#425047" color="#a7c080"];
    sel [label="margin select\nselection dispatcher"];
  }
  subgraph cluster_store { label="artifact store  ~/.local/state/margin/<project>/"; color="#475258"; style=rounded;
    doc [label="doc.json\nAI-owned content, rev" shape=note];
    state [label="state.json\nhuman state: ticks, picks, pins" shape=note];
    ui [label="view.json\nscroll, folds, focus" shape=note];
    ev [label="events.jsonl\nappend-only" shape=note];
  }
  subgraph cluster_z { label="Zellij 0.45 session"; color="#475258"; style=rounded;
    zact [label="zellij action\nlist-panes · new-pane --tab-id --no-focus"];
    pane [label="pane in tab T\nsplit or pinned float"];
    copy [label="copy_command\n(on select)"];
  }
  ghost [label="Ghostty\n(local or over ssh)"];
  open [label="opener / xdg-open"];
  cc -> cli [label="Bash tool"];
  cc -> mcp [style=dashed];
  cli -> doc; cli -> zact [label="open/reuse"]; zact -> pane;
  pane -> view [dir=none style=dotted label="runs"];
  doc -> view [label="inotify"]; state -> view; view -> ui; view -> state; view -> ev [label="tick, fold, pick"];
  pane -> ghost [label="cells + kitty images"];
  ghost -> copy [label="double-click token"]; copy -> sel; sel -> state; sel -> ev; sel -> open [label="URL"];
  ev -> hook [label="unread"]; hook -> cc [label="next prompt"];
}
